{
  "name": "YYC Library",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:server\"",
    "dev:lan": "concurrently -k -n web,api -c cyan,magenta \"vite --host\" \"npm:server\"",
    "dev:web": "vite",
    "server": "node server/index.js",
    "build": "vite build",
    "start": "npm run build && node server/index.js",
    "lint": "eslint .",
    "reindex": "node scripts/reindex.mjs",
    "eval": "node scripts/eval.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:staging": "node --test \"test/staging/*.staging.mjs\"",
    "preview": "vite preview",
    "e2e": "playwright test",
    "budget": "node scripts/check-budget.mjs",
    "perf": "playwright test e2e/perf.spec.js",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "dompurify": "^3.4.18",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "mammoth": "^1.12.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanitize-html": "2.18.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
