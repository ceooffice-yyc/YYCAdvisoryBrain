GROQ_API_KEY=your-groq-api-key-here
# Optional extra keys (e.g. from other Groq accounts). When one hits its rate limit the next is used automatically.
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=
# GROQ_API_KEY_4=
PORT=8787
# Default is 127.0.0.1 (this PC only). Use 0.0.0.0 only when running `npm start` for the team on the LAN.
# HOST=0.0.0.0

# --- Shared online database + sign-in (Supabase). Leave these out to keep the library in each browser's own storage (no sign-in). ---
# SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase → Project Settings → API → "anon public" key. Safe for browsers (it is sent to the page so it can sign people in).
# SUPABASE_ANON_KEY=
# Server only. Never prefix with VITE_ and never commit it. (Supabase → Project Settings → API → service_role)
# SUPABASE_SERVICE_ROLE_KEY=
# Who is an admin (comma separated emails). Everyone else who can sign in is a viewer. You can also set app_metadata.role = admin (see supabase/schema.sql).
# ADMIN_EMAILS=you@yourcompany.com
# Optional: only these email domains may use the app, e.g. yycadvisors.com
# ALLOWED_EMAIL_DOMAINS=
# "Continue as guest" lets anyone browse the knowledge base and lever records without an account. Set to false to require sign-in.
# ALLOW_GUEST=false
